              "name": "400 Bad Request",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/customers",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "customers"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"\",\n  \"email\": \"bad\"\n}"
                }
              },
              "status": "Bad Request",
              "code": 400,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"timestamp\": \"2026-10-14T04:00:14.410577Z\",\n  \"status\": 400,\n  \"message\": \"Validation failed\",\n  \"details\": [\n    \"email: must be a well-formed email address\",\n    \"name: must not be blank\"\n  ]\n}"
            }
          ],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Lists validation errors\", () => { const j = pm.response.json(); pm.expect(j.message).to.eql(\"Validation failed\"); pm.expect(j.details.length).to.be.above(0); });"
                ]
              }
            }
          ]
        },
        {
