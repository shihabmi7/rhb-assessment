  "item": [
    {
      "name": "Customers",
      "item": [
        {
          "name": "Get customer",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/customers/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customers",
                "1"
              ]
            }
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/customers/1",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "customers",
                    "1"
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"id\": 1,\n  \"name\": \"Alice Tan\",\n  \"email\": \"alice@example.com\",\n  \"city\": \"Kuala Lumpur\"\n}"
            }
          ],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Has customer fields\", () => { const j = pm.response.json(); pm.expect(j).to.have.keys(\"id\",\"name\",\"email\",\"city\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Search customers (paged)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/customers/search?name=a&city=Penang&page=0&size=5&sort=name,asc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customers",
                "search"
              ],
              "query": [
                {
                  "key": "name",
                  "value": "a"
                },
                {
                  "key": "city",
                  "value": "Penang"
                },
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "5"
                },
                {
                  "key": "sort",
                  "value": "name,asc"
                }
              ]
            }
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/customers/search?name=a&city=Penang&page=0&size=5&sort=name,asc",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "customers",
                    "search"
                  ],
                  "query": [
                    {
                      "key": "name",
                      "value": "a"
                    },
                    {
                      "key": "city",
                      "value": "Penang"
                    },
                    {
                      "key": "page",
                      "value": "0"
                    },
                    {
                      "key": "size",
                      "value": "5"
                    },
                    {
                      "key": "sort",
                      "value": "name,asc"
                    }
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"content\": [\n    {\n      \"id\": 5,\n      \"name\": \"Ethan Ng\",\n      \"email\": \"ethan@example.com\",\n      \"city\": \"Penang\"\n    }\n  ],\n  \"page\": 0,\n  \"size\": 5,\n  \"totalElements\": 1,\n  \"totalPages\": 1\n}"
            }
          ],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Page shape and filter\", () => { const j = pm.response.json(); pm.expect(j).to.have.keys(\"content\",\"page\",\"size\",\"totalElements\",\"totalPages\"); j.content.forEach(c => pm.expect(c.city).to.eql(\"Penang\")); pm.expect(j.content.length).to.be.at.most(5); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Create customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/customers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customers"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Farah Hassan\",\n  \"email\": \"{{uniqueEmail}}\",\n  \"city\": \"Ipoh\"\n}"
            }
          },
          "response": [
            {
              "name": "201 Created",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/customers",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "customers"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Farah Hassan\",\n  \"email\": \"farah@example.com\",\n  \"city\": \"Ipoh\"\n}"
                }
              },
              "status": "Created",
              "code": 201,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"id\": 6,\n  \"name\": \"Farah Hassan\",\n  \"email\": \"farah@example.com\",\n  \"city\": \"Ipoh\"\n}"
            }
          ],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"uniqueEmail\", \"user\" + Date.now() + \"@example.com\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Returns Location header and body\", () => { const j = pm.response.json(); pm.expect(pm.response.headers.get(\"Location\")).to.include(\"/api/customers/\" + j.id); pm.expect(j.name).to.eql(\"Farah Hassan\"); pm.collectionVariables.set(\"newCustomerId\", j.id); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Update customer (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/customers/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customers",
                "1"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"city\": \"Kuching\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Only city changed\", () => { const j = pm.response.json(); pm.expect(j.city).to.eql(\"Kuching\"); pm.expect(j.name).to.eql(\"Alice Tan\"); });"
                ]
              }
            }
          ]
        },
        {
