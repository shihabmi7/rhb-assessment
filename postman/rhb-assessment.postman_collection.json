              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Order starts PENDING\", () => { const j = pm.response.json(); pm.expect(j.status).to.eql(\"PENDING\"); pm.collectionVariables.set(\"newOrderId\", j.id); });"
                ]
              }
